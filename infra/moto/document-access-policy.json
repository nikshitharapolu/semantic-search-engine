{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDocumentBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::rag-documents"
    },
    {
      "Sid": "ReadWriteDocumentObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::rag-documents/documents/*"
    }
  ]
}
